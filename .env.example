# Upstash Redis (required on Vercel; leave empty locally to use the in-memory store).
# Adding Upstash from the Vercel Marketplace sets KV_REST_API_URL / KV_REST_API_TOKEN for you.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternatively, from the Upstash console:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
